# ==============================================================================
# PhishGuard AI — .gitignore
# ==============================================================================

# --- Virtual Environment ---
.venv/
venv/
env/
ENV/

# --- Python Bytecode & Caches ---
__pycache__/
*.py[cod]
*$py.class
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Environment & Secrets ---
.env
.env.*
*.env
secrets.json
config.local.py

# --- Dataset Files (too large for GitHub; downloaded automatically by data_loader.py) ---
data/raw/
data/processed/

# --- Trained Models & Artifacts (regenerated by train_model.py) ---
models/*.pkl
models/model_metadata.json

# Keep evaluation charts in models/ for the README screenshots
# (uncomment the line below if you do NOT want charts committed)
# models/*.png

# --- Jupyter Notebook Checkpoints ---
.ipynb_checkpoints/
*.ipynb_checkpoints

# --- Distribution / Packaging ---
dist/
build/
*.egg-info/
*.egg
MANIFEST

# --- Type Checking & Coverage ---
.dmypy.json
dmypy.json
.coverage
coverage.xml
htmlcov/
*.cover

# --- OS / Editor Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Desktop.ini
ehthumbs.db

# --- IDEs ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.user

# --- Logs ---
*.log
logs/
